# ─────────────────────────────────────────────────────────────────────────────
# Kapucinus Kávézó — environment. Copy to `.env` (Docker) or `.env.local` (dev).
# Never commit the filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the site, used for canonical URLs, the sitemap, and Open Graph.
# Read at runtime, so one Docker image serves any domain.
SITE_URL=https://example.com

# Admin login. Generate the hash with:  npm run admin:hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Local development only: a plain password instead of the hash. Refused in production.
# ADMIN_PASSWORD=

# Signs admin sessions. At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Where the SQLite database and uploaded images are stored. In Docker this is the
# named volume mounted at /app/data; leave it unset to use ./data locally.
# DATA_DIR=/app/data

# Largest image an admin may upload, in megabytes (default 12).
# MAX_UPLOAD_MB=12

# Set to false only to test a production build over plain http://localhost.
# COOKIE_SECURE=false
